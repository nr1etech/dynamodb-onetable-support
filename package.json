{
  "name": "@nr1e/dynamodb-onetable-support",
  "description": "Supporting functionality and patterns for use with dynamodb-onetable",
  "version": "0.2.2",
  "type": "module",
  "author": "NR1E, Inc.",
  "publishConfig": {
    "access": "public"
  },
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/nr1etech/dynamodb-onetable-support.git"
  },
  "files": [
    "**"
  ],
  "scripts": {
    "build": "tsc",
    "postbuild": "prettier --check . && gts lint && cp package.json dist",
    "watch": "tsc -w",
    "test": "vitest run --coverage",
    "lint": "gts lint",
    "clean": "rm -rf dist && rm -rf site && rm -rf coverage",
    "fix": "gts fix",
    "makepretty": "prettier --write .",
    "site": "typedoc --out site \"src/**/*.mts\" --exclude \"src/**/*.test.mts\""
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.138",
    "@types/node": "22.0.0",
    "gts": "^5.3.1",
    "ts-node": "^10.9.2",
    "typedoc": "^0.25.13",
    "typescript": "~5.4.5",
    "@vitest/coverage-v8": "^1.6.0",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "@nr1e/commons": "^0.1.1",
    "@nr1e/dynamodb-support": "^0.2.2",
    "@nr1e/logging": "^1.1.0",
    "dynamodb-onetable": "^2.7.2",
    "tslib": "^2.6.3"
  },
  "peerDependencies": {
    "@nr1e/commons": "^0.1.2",
    "@nr1e/dynamodb-support": "^0.2.2",
    "@nr1e/logging": "^1.1.0",
    "dynamodb-onetable": "^2.7.2"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": "./index.mjs",
      "types": "./index.d.mts"
    }
  }
}
